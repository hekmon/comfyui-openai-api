{
  "1": {
    "class_type": "OAIAPI_Client",
    "_meta": {
      "title": "Client (set your server Base URL)"
    },
    "inputs": {
      "base_url": "http://localhost:11434/v1",
      "max_retries": 2,
      "timeout": 600
    }
  },
  "2": {
    "class_type": "OAIAPI_LoadMemory",
    "_meta": {
      "title": "Load Memory (previous run history)"
    },
    "inputs": {
      "key": "chat",
      "reset": false
    }
  },
  "3": {
    "class_type": "OAIAPI_ChatCompletion",
    "_meta": {
      "title": "Chat Completion (edit the prompt then queue)"
    },
    "inputs": {
      "client": [
        "1",
        0
      ],
      "model": "your-model-name",
      "force_regen": false,
      "prompt": "Hello! My name is Alex. Please remember it.",
      "system_prompt": "You are a friendly assistant. Keep your answers short.",
      "history": [
        "2",
        0
      ]
    }
  },
  "4": {
    "class_type": "OAIAPI_TrimHistory",
    "_meta": {
      "title": "Trim History (keep the last turns)"
    },
    "inputs": {
      "history": [
        "3",
        1
      ],
      "max_turns": 10
    }
  },
  "5": {
    "class_type": "OAIAPI_SaveMemory",
    "_meta": {
      "title": "Save Memory (for the next run)"
    },
    "inputs": {
      "key": "chat",
      "value": [
        "4",
        0
      ]
    }
  },
  "6": {
    "class_type": "PreviewAny",
    "_meta": {
      "title": "Answer"
    },
    "inputs": {
      "source": [
        "3",
        0
      ]
    }
  }
}
